# Copy this file to keystore.properties (same folder as settings.gradle)
# and fill in your values. keystore.properties is gitignored — never commit it.
#
# storeFile path is relative to the project root, or use an absolute path.
# Example if you saved the keystore in your user folder:
#   storeFile=C\:\\Users\\Avishay\\ywalk-release.jks
#
# For Cloud Agent / CI automatic signed builds, do NOT commit this file.
# Add secrets instead (see docs/PLAY_SIGNING.md):
#   YWALK_KEYSTORE_BASE64, YWALK_STORE_PASSWORD, YWALK_KEY_ALIAS, YWALK_KEY_PASSWORD
# then run: ./scripts/prepare-release-signing.sh && ./gradlew :app:bundleRelease

storeFile=
storePassword=
keyAlias=
keyPassword=
