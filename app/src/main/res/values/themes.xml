<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.StepTracker" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/surface_dark</item>
        <!-- Filled (accent) buttons get white text; light secondary buttons
             override textColor explicitly in their layouts. -->
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorSecondary">@color/accent_2</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/grad_top</item>
        <item name="android:navigationBarColor">@color/grad_bottom</item>
        <!-- Light system bars => use dark status/nav icons -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>
</resources>
