<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/helpRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/bg_app_image">

    <TextView
        android:id="@+id/tvHelpBrand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Y Walk"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:letterSpacing="0.02" />

    <TextView
        android:id="@+id/tvHelpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvHelpBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:textSize="16sp"
        android:lineSpacingMultiplier="1.35"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/tvHelpPage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="12sp"
        android:textColor="@color/text_hint"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelpSkip"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Skip"
            android:textColor="@color/text_primary"
            app:cornerRadius="26dp"
            android:backgroundTint="@color/surface_elevated"
            app:strokeColor="@color/text_hint"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHelpNext"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Next"
            app:cornerRadius="26dp"
            android:backgroundTint="@color/accent" />
    </LinearLayout>
</LinearLayout>
