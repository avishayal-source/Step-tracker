<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="@color/surface_dark">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LET'S GO"
            android:textSize="18sp"
            android:letterSpacing="0.2"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/surface_dark"
        app:tabTextColor="@color/text_secondary"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabIndicatorColor="@color/accent"
        app:tabIndicatorHeight="3dp">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏃 Tracking" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Schedule" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 History" />
    </com.google.android.material.tabs.TabLayout>

    <!-- ═══════════════════════════════════════ PAGE: TRACKING ═══ -->
    <ScrollView
        android:id="@+id/pageTracking"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Hero card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="20dp"
                android:paddingBottom="16dp"
                android:paddingHorizontal="20dp"
                android:background="@color/surface_dark">

                <!-- Row: activity pill + GPS badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCurrentActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not tracking"
                        android:textSize="15sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/pill_background"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="5dp" />

                    <TextView
                        android:id="@+id/tvGpsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/accent"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <!-- Step counter -->
                <TextView
                    android:id="@+id/tvStepCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="48sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="steps"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="-6dp" />

                <TextView
                    android:id="@+id/tvSessionElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginTop="6dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSessionElapsedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="session time"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <!-- Total distance -->
                <TextView
                    android:id="@+id/tvTotalDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 m"
                    android:textSize="36sp"
                    android:textColor="@color/accent"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="total distance"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

                <!-- Walk / Run split -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="14dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        app:cardBackgroundColor="@color/color_walking_card"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/tvWalkStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🚶 Walk\n0 steps\n0 m"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.4"
                            android:padding="12dp" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        app:cardBackgroundColor="@color/color_running_card"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/tvRunStats"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏃 Run\n0 steps\n0 m"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:lineSpacingMultiplier="1.4"
                            android:padding="12dp" />
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- Buttons row -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartStop"
                        android:layout_width="130dp"
                        android:layout_height="48dp"
                        android:text="▶  Start"
                        android:textSize="15sp"
                        app:cornerRadius="24dp"
                        android:backgroundTint="@color/accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReset"
                        android:layout_width="90dp"
                        android:layout_height="48dp"
                        android:text="↺ Reset"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="24dp"
                        android:backgroundTint="@color/surface_dark"
                        app:strokeColor="@color/text_secondary"
                        app:strokeWidth="1dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalibrate"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:text="⚙ Calibrate"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="24dp"
                        android:backgroundTint="@color/surface_dark"
                        app:strokeColor="@color/accent"
                        app:strokeWidth="1dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Log header row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="18dp"
                android:paddingBottom="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ACTIVITY LOG"
                    android:textSize="11sp"
                    android:letterSpacing="0.15"
                    android:textColor="@color/text_secondary"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Log totals -->
            <TextView
                android:id="@+id/tvLogTotals"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="20dp"
                android:paddingBottom="8dp"
                android:textSize="12sp"
                android:textColor="@color/accent"
                android:visibility="gone" />

            <!-- Empty hint -->
            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Start tracking to see your activity log here"
                android:gravity="center"
                android:paddingVertical="24dp"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Log list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:nestedScrollingEnabled="false"
                android:clipToPadding="false" />

        </LinearLayout>
    </ScrollView>

    <!-- ═══════════════════════════════════════ PAGE: SCHEDULE ═══ -->
    <LinearLayout
        android:id="@+id/pageSchedule"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Running overlay -->
        <LinearLayout
            android:id="@+id/schedLayoutRunning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:paddingHorizontal="24dp"
            android:background="@color/surface_dark"
            android:visibility="gone">

            <TextView
                android:id="@+id/schedTvCurrentPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚶 Walking  ·  period 1 of 5"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/schedTvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="52sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="4dp" />

            <ProgressBar
                android:id="@+id/schedProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:progressTint="@color/accent"
                android:progressBackgroundTint="#2A2D40"
                android:max="100" />
        </LinearLayout>

        <!-- Totals bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:background="@color/surface_dark">

            <TextView
                android:id="@+id/schedTvTotalWalk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚶 Walk: 0m"
                android:textSize="13sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/schedTvTotalJog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏃 Jog: 0m"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:gravity="end" />
        </LinearLayout>

        <!-- Schedule list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/schedRvSchedule"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:clipToPadding="false" />

        <!-- Bottom controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="12dp"
            android:background="@color/surface_dark">

            <!-- Add buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedBtnAddWalk"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="+ Walk"
                    android:textSize="13sp"
                    app:cornerRadius="21dp"
                    android:backgroundTint="@color/color_walking" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedBtnAddJog"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="+ Jog"
                    android:textSize="13sp"
                    app:cornerRadius="21dp"
                    android:backgroundTint="@color/color_running" />
            </LinearLayout>

            <!-- Save / Load row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedBtnSave"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="💾 Save"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    android:backgroundTint="@color/surface_dark"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedBtnLoad"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="📂 Load"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    android:backgroundTint="@color/surface_dark"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Swipe to delete  ·  drag to reorder  ·  ± to adjust"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/schedBtnStartStop"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="▶  Start"
                android:textSize="16sp"
                app:cornerRadius="25dp"
                android:backgroundTint="@color/accent" />
        </LinearLayout>

    </LinearLayout>


    <!-- ═══════════════════════════════════════ PAGE: HISTORY ═══ -->
    <LinearLayout
        android:id="@+id/pageHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- All-time summary -->
        <TextView
            android:id="@+id/tvHistorySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:lineSpacingMultiplier="1.5"
            android:background="@color/surface_dark" />

        <TextView
            android:id="@+id/tvHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No workouts recorded yet.
Start a tracking session to build your history."
            android:gravity="center"
            android:paddingVertical="48dp"
            android:paddingHorizontal="32dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="8dp"
            android:clipToPadding="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long-press a workout to delete it"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:paddingVertical="8dp"
            android:background="@color/surface_dark" />

    </LinearLayout>

</LinearLayout>