<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- Title bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="@android:color/transparent">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚡ LET'S GO"
            android:textSize="20sp"
            android:letterSpacing="0.18"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-black" />
    </LinearLayout>

    <!-- Gradient accent underline -->
    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_accent_gradient_bar" />

    <!-- Tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        app:tabTextColor="@color/text_secondary"
        app:tabSelectedTextColor="@color/text_primary"
        app:tabIndicatorColor="@color/accent"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp">
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏃 Tracking" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Schedule" />
        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 History" />
    </com.google.android.material.tabs.TabLayout>

    <!-- ═══════════════════════════════════════ PAGE: TRACKING ═══ -->
    <ScrollView
        android:id="@+id/pageTracking"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- ── Hero card (gradient) ──────────────────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_hero"
                android:paddingTop="22dp"
                android:paddingBottom="22dp"
                android:paddingHorizontal="20dp"
                android:elevation="6dp">

                <!-- Activity pill + GPS -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvCurrentActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Not tracking"
                        android:textSize="14sp"
                        android:textColor="@color/text_primary"
                        android:background="@drawable/pill_background"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="7dp" />

                    <TextView
                        android:id="@+id/tvGpsIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="11sp"
                        android:textColor="@color/accent_cyan"
                        android:layout_marginStart="10dp" />
                </LinearLayout>

                <!-- Step sizes (calibrated) -->
                <TextView
                    android:id="@+id/tvStepSizes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="8dp" />

                <!-- Step count -->
                <TextView
                    android:id="@+id/tvStepCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="64sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-thin"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STEPS"
                    android:textSize="10sp"
                    android:letterSpacing="0.25"
                    android:textColor="@color/accent_cyan"
                    android:layout_marginTop="-10dp" />

                <!-- Session time -->
                <TextView
                    android:id="@+id/tvSessionElapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00"
                    android:textSize="20sp"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-light"
                    android:layout_marginTop="10dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvSessionElapsedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SESSION TIME"
                    android:textSize="9sp"
                    android:letterSpacing="0.15"
                    android:textColor="@color/text_secondary"
                    android:visibility="gone" />

                <!-- Total distance -->
                <TextView
                    android:id="@+id/tvTotalDist"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 m"
                    android:textSize="38sp"
                    android:textColor="@color/accent"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL DISTANCE"
                    android:textSize="9sp"
                    android:letterSpacing="0.2"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="-4dp" />

                <!-- Walk / Run split cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <TextView
                        android:id="@+id/tvWalkStats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/card_stat_walk"
                        android:text="🚶 Walk\n0 steps\n0 m"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5"
                        android:padding="16dp" />

                    <TextView
                        android:id="@+id/tvRunStats"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="5dp"
                        android:background="@drawable/card_stat_run"
                        android:text="🏃 Run\n0 steps\n0 m"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5"
                        android:padding="16dp" />
                </LinearLayout>

                <!-- Buttons -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="18dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartStop"
                        android:layout_width="140dp"
                        android:layout_height="52dp"
                        android:text="▶  Start"
                        android:textSize="16sp"
                        android:letterSpacing="0.03"
                        app:cornerRadius="26dp"
                        android:backgroundTint="@color/accent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnReset"
                        android:layout_width="92dp"
                        android:layout_height="52dp"
                        android:text="↺  Reset"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="26dp"
                        android:backgroundTint="@color/surface_elevated"
                        app:strokeColor="@color/text_hint"
                        app:strokeWidth="1dp"
                        android:visibility="gone" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCalibrate"
                        android:layout_width="wrap_content"
                        android:layout_height="52dp"
                        android:text="⚙  Calibrate"
                        android:textSize="12sp"
                        android:layout_marginStart="8dp"
                        app:cornerRadius="26dp"
                        android:backgroundTint="@color/surface_elevated"
                        app:strokeColor="@color/accent"
                        app:strokeWidth="1dp" />
                </LinearLayout>

            </LinearLayout>

            <!-- ── Session timeline ───────────────────────────────────── -->
            <LinearLayout
                android:id="@+id/layoutTimeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_surface_card"
                android:padding="14dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="SESSION TIMELINE"
                    android:textSize="10sp"
                    android:letterSpacing="0.15"
                    android:textColor="@color/accent_cyan"
                    android:fontFamily="sans-serif-medium"
                    android:paddingBottom="10dp" />

                <!-- Coloured bar: segments added programmatically -->
                <LinearLayout
                    android:id="@+id/timelineBar"
                    android:layout_width="match_parent"
                    android:layout_height="18dp"
                    android:orientation="horizontal"
                    android:clipChildren="false"
                    android:clipToPadding="false" />

                <!-- Walk / run summary line -->
                <TextView
                    android:id="@+id/tvLogTotals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingMultiplier="1.5"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Empty hint (shown before first session starts) -->
            <TextView
                android:id="@+id/tvEmptyHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👟 Start tracking to see your session timeline"
                android:gravity="center"
                android:paddingVertical="28dp"
                android:paddingHorizontal="24dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <!-- ═══════════════════════════════════════ PAGE: SCHEDULE ═══ -->
    <LinearLayout
        android:id="@+id/pageSchedule"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Running overlay -->
        <LinearLayout
            android:id="@+id/schedLayoutRunning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingVertical="20dp"
            android:paddingHorizontal="24dp"
            android:background="@drawable/bg_hero"
            android:elevation="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/schedTvCurrentPeriod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚶 Walking  ·  period 1 of 5"
                android:textSize="16sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/schedTvCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textSize="56sp"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-light"
                android:layout_marginTop="4dp" />

            <ProgressBar
                android:id="@+id/schedProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="10dp"
                android:progressTint="@color/accent_cyan"
                android:progressBackgroundTint="#332A3360"
                android:max="100" />
        </LinearLayout>

        <!-- Totals bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:background="@drawable/bg_surface_card">

            <TextView
                android:id="@+id/schedTvTotalWalk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🚶 Walk: 0m"
                android:textSize="13sp"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/schedTvTotalJog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🏃 Jog: 0m"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:gravity="end" />
        </LinearLayout>

        <!-- Schedule list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/schedRvSchedule"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:clipToPadding="false" />

        <!-- Bottom controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:background="@color/surface_dark">

            <!-- Add buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedBtnAddWalk"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="+ Walk"
                    android:textSize="13sp"
                    app:cornerRadius="22dp"
                    android:backgroundTint="@color/color_walking" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedBtnAddJog"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="+ Jog"
                    android:textSize="13sp"
                    app:cornerRadius="22dp"
                    android:backgroundTint="@color/color_running" />
            </LinearLayout>

            <!-- Save / Load row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedBtnSave"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="💾 Save"
                    android:textSize="13sp"
                    app:cornerRadius="21dp"
                    android:backgroundTint="@color/surface_elevated"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/schedBtnLoad"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="📂 Load"
                    android:textSize="13sp"
                    app:cornerRadius="21dp"
                    android:backgroundTint="@color/surface_elevated"
                    app:strokeColor="@color/accent"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Swipe to delete  ·  drag to reorder  ·  ± to adjust"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/schedBtnStartStop"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="▶  Start"
                android:textSize="16sp"
                app:cornerRadius="26dp"
                android:backgroundTint="@color/accent" />
        </LinearLayout>

    </LinearLayout>


    <!-- ═══════════════════════════════════════ PAGE: HISTORY ═══ -->
    <LinearLayout
        android:id="@+id/pageHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- All-time summary -->
        <TextView
            android:id="@+id/tvHistorySummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:padding="18dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.6"
            android:background="@drawable/bg_hero" />

        <!-- Auto-generated insights (pace trend, streak, frequency, PBs) -->
        <TextView
            android:id="@+id/tvHistoryInsights"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            android:padding="16dp"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:lineSpacingMultiplier="1.5"
            android:background="@drawable/bg_surface_card"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvHistoryEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 No workouts recorded yet.
Start a tracking session to build your history."
            android:gravity="center"
            android:paddingVertical="48dp"
            android:paddingHorizontal="32dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.5"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHistory"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingVertical="4dp"
            android:clipToPadding="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Long-press a workout to delete it"
            android:gravity="center"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:paddingVertical="10dp" />

    </LinearLayout>

</LinearLayout>
