<?xml version="1.0" encoding="utf-8"?>
<!--
  Exclude all app data from cloud / adb backup. Workout history, coach profile
  and debug artefacts stay on-device only.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
